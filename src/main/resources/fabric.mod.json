{
	"schemaVersion": 1,
	"id": "evergun",
	"version": "${version}",
	"name": "EVERgun",
	"description": "A simple mod which adds an arrow gun into the game with 2 new vanilla enchantments",
	"authors": [
		"EVER2east", "Crystal"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/evergun",
		"sources": "https://github.com/EVER1east/EVERgun",
        "issues": "https://github.com/EVER1east/EVERgun/issues"
	},
	"license": "MIT",
	"icon": "assets/evergun/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"evergun.modid.EVERgun"
		],
		"client": [
			"evergun.modid.EVERgunClient"
		],
		"fabric-datagen": [
			"evergun.modid.EVERgunDataGenerator"
		]
	},
	"mixins": [
		"evergun.mixins.json",
		{
			"config": "evergun.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}